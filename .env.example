# Copy to .env — do not commit .env

# --- Supabase (session pooler, port 5432) ---
# Dashboard → Connect → Session mode. Encode % in password as %25.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

# --- Django API ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: add your Vercel URL, e.g. https://fitconnect.vercel.app
# Optional regex (pipe-separated); default in production allows https://*.vercel.app
# CORS_ALLOWED_ORIGIN_REGEXES=^https://[\w-]+\.vercel\.app$
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Next.js (public API URL for browser; use https://your-api.onrender.com/api in prod) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
