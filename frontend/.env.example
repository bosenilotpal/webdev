# Copy to .env.local for local development

# Browser requests — must be the public Django API (not Next.js /api)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Server-side fetches in Next.js
API_URL=http://127.0.0.1:8000/api
API_ORIGIN=http://127.0.0.1:8000

# Production (Vercel) — set in project Environment Variables:
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com/api
# API_URL=https://your-api.onrender.com/api
# API_ORIGIN=https://your-api.onrender.com
